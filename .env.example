# Copy to .env (gitignored) and fill in. Never commit real keys.

# Agent-run spike research (research-protocol.mdc Section I).
# Used only by scripts/spike_research.py. Read from the environment, never written to disk.
WELLBE_RESEARCH_API_KEY=

# Optional overrides (defaults shown):
# WELLBE_RESEARCH_MODEL=gpt-5.5-pro
# WELLBE_RESEARCH_BASE_URL=https://api.openai.com/v1
# WELLBE_RESEARCH_WEB_SEARCH=1

# --- Web app (apps/web) ---
# API base URL. Defaults to the local kind cluster ingress host.
# NEXT_PUBLIC_WELLBE_API_URL=http://api.localhost

# Dev session (T0.4 / WEL-151). Until ZITADEL OIDC lands, the web app authenticates
# with these dev headers (backend resolve_principal). Set the actor id to a seeded
# patient so /v1/threads + /v2/pending-items return data. Patient defaults to actor;
# actor type defaults to "controller" (self-access). Leave blank to see the calm
# sign-in state instead of data.
# NEXT_PUBLIC_WELLBE_DEV_ACTOR_ID=
# NEXT_PUBLIC_WELLBE_DEV_PATIENT_ID=
# NEXT_PUBLIC_WELLBE_DEV_ACTOR_TYPE=controller
